{
    "issuer": "https://oauth.clozd.com",
    "authorization_endpoint": "https://oauth.clozd.com/authorize",
    "token_endpoint": "https://oauth.clozd.com/token",
    "userinfo_endpoint": "https://oauth.clozd.com/userinfo",
    "revocation_endpoint": "https://oauth.clozd.com/revoke",
    "introspection_endpoint": "https://oauth.clozd.com/introspect",
    "jwks_uri": "https://oauth.clozd.com/.well-known/jwks.json",
    "registration_endpoint": "https://oauth.clozd.com/register",
    "scopes_supported": [
        "openid",
        "profile",
        "email",
        "offline_access",
        "api"
    ],
    "response_types_supported": [
        "code"
    ],
    "grant_types_supported": [
        "authorization_code",
        "client_credentials",
        "refresh_token"
    ],
    "token_endpoint_auth_methods_supported": [
        "client_secret_basic",
        "client_secret_post",
        "none"
    ],
    "code_challenge_methods_supported": [
        "S256"
    ],
    "subject_types_supported": [
        "public"
    ],
    "id_token_signing_alg_values_supported": [
        "RS256"
    ],
    "client_id_metadata_document_supported": true
}

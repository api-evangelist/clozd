        {
          "id": "a831bd5b-ea63-4ea5-99d1-35cfded09515",
          "name": "Get list of competitors",
          "request": {
            "name": "Get list of competitors",
            "description": {
              "content": "Get a paginated list of competitors for a program (optionally with deals and responses referenced by competitors). Make sure the header is set with a key value pair being Key: x-api-token Value: (api token provided from the settings section within the Clozd application).\n - :program_id is required, you can get the program id from the settings page within the Clozd app.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "programs",
                ":program_id",
                "competitors"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "1000",
                  "description": "Limit for paging (min:1, max:1000)"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Offset for paging (min:0, max:100000)"
                },
                {
                  "disabled": false,
                  "key": "filter[competitor_updated_since]",
                  "value": "<dateTime>",
                  "description": "Returns only competitors updated since the date and time specified. Specifying this parameter will enable periodic query of incremental changes since the last pull (instead of always having to pull all competitors). (max:25 chars, ISO8601 date-time format)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "program_id",
                  "description": "(Required) Clozd program ID (min:36 chars, max:36 chars)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-api-token"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
